# Copy to `.env` at the repository root. Both the Prisma CLI
# (packages/database/prisma.config.ts) and the API read this same file.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/blank_template?schema=public"

# apps/api
PORT=4000

# apps/api auth. JWT_SECRET has no default on purpose — generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""
# Optional overrides (defaults: 15m / 30d / 60d). COOKIE_DOMAIN only in
# production when web and api share a registrable domain.
# JWT_ACCESS_TTL="15m"
# REFRESH_TTL_WEB="30d"
# REFRESH_TTL_MOBILE="60d"
# COOKIE_DOMAIN=""

# apps/api e2e tests — a separate database that the suite may TRUNCATE freely.
# Never point this at a database with real data.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/blank_template_test?schema=public"

# apps/web-portal (build-time, exposed to the browser)
VITE_API_URL="http://localhost:4000"
