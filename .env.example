# Copy to `.env` at the repository root. Both the Prisma CLI
# (packages/database/prisma.config.ts) and the API read this same file.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/blank_template?schema=public"

# apps/api
PORT=4000

# apps/web (build-time, exposed to the browser)
VITE_API_URL="http://localhost:4000"
