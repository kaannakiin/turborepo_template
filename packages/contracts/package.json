{
  "name": "@repo/contracts",
  "version": "0.0.0",
  "private": true,
  "sideEffects": false,
  "exports": {
    "./shared": {
      "types": "./dist/shared.d.ts",
      "import": "./dist/shared.mjs",
      "default": "./dist/shared.js"
    },
    "./control-plane/identity": {
      "types": "./dist/control-plane/identity.d.ts",
      "import": "./dist/control-plane/identity.mjs",
      "default": "./dist/control-plane/identity.js"
    },
    "./control-plane/tenancy": {
      "types": "./dist/control-plane/tenancy.d.ts",
      "import": "./dist/control-plane/tenancy.mjs",
      "default": "./dist/control-plane/tenancy.js"
    },
    "./control-plane/access": {
      "types": "./dist/control-plane/access.d.ts",
      "import": "./dist/control-plane/access.mjs",
      "default": "./dist/control-plane/access.js"
    },
    "./control-plane/platform": {
      "types": "./dist/control-plane/platform.d.ts",
      "import": "./dist/control-plane/platform.mjs",
      "default": "./dist/control-plane/platform.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@repo/database": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:"
  }
}
