{
  "extends": "@repo/typescript-config/base.json",
  "compilerOptions": {
    // tsup/esbuild bundles this package, so extensionless relative imports are
    // resolved by the bundler — NodeNext from base.json would demand `.js` suffixes.
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "noEmit": true,
    "declaration": false,
    "declarationMap": false
  },
  "include": ["src", "tsup.config.ts"],
  "exclude": ["node_modules", "dist"]
}
