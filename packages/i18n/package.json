{
  "name": "@repo/i18n",
  "version": "0.0.0",
  "private": true,
  "sideEffects": false,
  "exports": {
    "./locale": {
      "types": "./dist/locale.d.ts",
      "import": "./dist/locale.mjs",
      "default": "./dist/locale.js"
    },
    "./instance": {
      "types": "./dist/instance.d.ts",
      "import": "./dist/instance.mjs",
      "default": "./dist/instance.js"
    },
    "./zod": {
      "types": "./dist/zod.d.ts",
      "import": "./dist/zod.mjs",
      "default": "./dist/zod.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "i18next": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:"
  }
}
