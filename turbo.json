{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "cacheMaxAge": "14d",
  "cacheMaxSize": "5GB",
  "envMode": "strict",
  "globalDependencies": ["pnpm-workspace.yaml", ".env"],
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "generate": {
      "cache": true,
      "inputs": ["prisma/schema/**", "prisma.config.ts"],
      "outputs": ["src/generated/prisma/**"]
    },
    "build": {
      "dependsOn": ["^build", "generate"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "!**/*.test.ts",
        "!**/*.spec.ts",
        "!test/**"
      ],
      "outputs": ["dist/**", "!**/*.tsbuildinfo"],
      "env": [
        "NODE_ENV",
        "VITE_API_URL",
        "DATABASE_URL",
        "JWT_SECRET",
        "JWT_ACCESS_TTL",
        "REFRESH_TTL_WEB",
        "REFRESH_TTL_MOBILE",
        "COOKIE_DOMAIN"
      ]
    },
    "lint": {
      "dependsOn": ["^topo"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!public/**", "!**/*.css"],
      "outputs": []
    },
    "check-types": {
      "dependsOn": ["^build", "generate"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!public/**", "!**/*.css"],
      "outputs": [],
      "env": ["DATABASE_URL"]
    },
    "dev": {
      "dependsOn": ["^build", "generate"],
      "cache": false,
      "persistent": true,
      "env": [
        "DATABASE_URL",
        "PORT",
        "CORS_ORIGINS",
        "VITE_API_URL",
        "JWT_SECRET",
        "JWT_ACCESS_TTL",
        "REFRESH_TTL_WEB",
        "REFRESH_TTL_MOBILE",
        "COOKIE_DOMAIN"
      ]
    },
    "test": {
      "dependsOn": ["^build", "generate"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "outputs": []
    },
    "test:e2e": {
      "dependsOn": ["^build", "generate"],
      "cache": false,
      "env": [
        "DATABASE_URL",
        "TEST_DATABASE_URL",
        "THROTTLE_E2E",
        "JWT_SECRET",
        "JWT_ACCESS_TTL",
        "REFRESH_TTL_WEB",
        "REFRESH_TTL_MOBILE",
        "COOKIE_DOMAIN",
        "CORS_ORIGINS",
        "PORT"
      ]
    },
    "topo": {
      "dependsOn": ["^topo"]
    },

    // Database tasks. Never cached — they talk to a live server, so a cache hit
    // would be a lie. `envMode: "strict"` means DATABASE_URL has to be declared
    // here or the Prisma CLI receives an empty environment.
    "db:migrate": {
      "cache": false,
      "persistent": true,
      "env": ["DATABASE_URL"]
    },
    "db:deploy": {
      "cache": false,
      "env": ["DATABASE_URL"]
    },
    "db:push": {
      "cache": false,
      "env": ["DATABASE_URL"]
    },
    "db:studio": {
      "cache": false,
      "persistent": true,
      "env": ["DATABASE_URL"]
    }
  }
}
